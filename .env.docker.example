# Copy to .env next to docker-compose.yml. Never commit the filled-in file.

# Public URL of the MCP endpoint, as Claude reaches it (no trailing /mcp).
MCP_PUBLIC_URL=https://carrefour.example.com

# Password asked once when you add the connector in Claude. 12+ characters.
# Generate one: openssl rand -base64 24
MCP_AUTH_PASSWORD=

# Optional: static bearer token for clients that do not do OAuth (Claude Code,
# scripts). 32+ characters: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# Remote sign-in screen. Carrefour's login needs a captcha and an emailed code
# at least once a day; this is where you type them, from any browser.
# VNC only uses the first 8 characters: keep the hostname behind Cloudflare Access.
VNC_PASSWORD=
CARREFOUR_REMOTE_LOGIN_URL=https://carrefour-login.example.com/vnc.html?autoconnect=1&resize=scale

# Optional
# CARREFOUR_TOOLSETS=history,cart,catalog,stores,loyalty,lists
# CARREFOUR_ENABLE_CHECKOUT=0
# TZ=Europe/Paris
