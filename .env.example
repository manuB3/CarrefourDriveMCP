# ---------------------------------------------------------------------------
# Carrefour session (required for tools marked "requires an authenticated session")
# ---------------------------------------------------------------------------
# Option A: paste the Cookie header copied from DevTools on www.carrefour.fr
# CARREFOUR_COOKIES="sessionid=...; other=..."
#
# Option B: point to a JSON cookie export (Playwright / EditThisCookie format)
# CARREFOUR_COOKIE_FILE=/absolute/path/to/carrefour-cookies.json
#
# Where the cookie jar is persisted (default: <project>/data/sessions/cookies.json)
# CARREFOUR_SESSION_FILE=/absolute/path/to/cookies.json

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Override the directory holding the JSON tool definitions
# CARREFOUR_TOOLS_DIR=/absolute/path/to/tools
# CARREFOUR_USER_AGENT="Mozilla/5.0 ..."
# CARREFOUR_MAX_RESPONSE_CHARS=60000
# REQUEST_TIMEOUT_MS=30000

# Rate limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000
MIN_DELAY_MS=100
MAX_DELAY_MS=500

# Logging (logs go to data/*.log and stderr; never to stdout)
LOG_LEVEL=info
# CARREFOUR_LOG_DIR=/absolute/path/to/logs

# Root of everything the server writes (session, browser profile, logs).
# Defaults to ~/.carrefour-drive-mcp, or the repo data/ dir in a source checkout.
# CARREFOUR_DATA_DIR=/absolute/path/to/dir

# Toolsets to expose, comma-separated, or "all". Default: everything except
# "marketing" and "checkout". Toolsets: catalog, cart, stores, history, loyalty,
# lists, account, marketing, checkout.
# CARREFOUR_TOOLSETS=history,cart

# Expose the checkout and payment tools. Off unless set to 1, even with
# CARREFOUR_TOOLSETS=all.
# CARREFOUR_ENABLE_CHECKOUT=1

# Compact responses (images, tracking, empty fields removed). Set to 0 for raw
# Carrefour payloads by default; any tool also accepts raw_response: true.
# CARREFOUR_COMPACT=0
